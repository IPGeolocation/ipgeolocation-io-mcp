# Customer keys belong in each MCP client's private headers, never here.
IPGEOLOCATION_MCP_HTTP_HOST=0.0.0.0
IPGEOLOCATION_MCP_HTTP_PORT=8787
IPGEOLOCATION_MCP_PUBLIC_URL=https://mcp.ipgeolocation.io/mcp
# Add exact browser origins only when a supported client needs browser CORS.
IPGEOLOCATION_MCP_ALLOWED_ORIGINS=
# Exact host-Nginx gateway address of the shipped private Docker network; logs only.
IPGEOLOCATION_MCP_TRUSTED_PROXIES=172.30.88.1
IPGEOLOCATION_MCP_HTTP_CONCURRENCY=32
IPGEOLOCATION_REQUEST_TIMEOUT_MS=15000
